;\n        grid-row: 2;\n    }\n\n    &>.delete-btn {\n        grid-column: 1/2;\n        grid-row: 1;\n        background: none;\n    }\n\n    &>.add-btn {\n        grid-column: 1/-1;\n    }\n\n    .new-step {\n        position: relative;\n        border: 1px dashed var(--accent-900);\n        background: none;\n        margin-bottom: .5em;\n        justify-self: center;\n        width: 100%;\n    }\n}\n\n.main-section .task-wrapper {\n    .task-title {\n        border-left: 1px solid var(--accent-900);\n        border-right: 1px dotted var(--accent-900);\n    }\n}\n\n.task-wrapper.sidebar-rendering {\n    grid-column: 1/-1;\n    grid-template-columns: 2em 3fr 1fr;\n    padding: 0 0.9em;\n\n    margin: initial;\n\n    .expand-btn {\n        grid-column: 1/2;\n    }\n\n    .task-title {\n        grid-column: 2/3;\n        white-space: nowrap;\n        overflow: hidden;\n        text-overflow: ellipsis;\n    }\n\n    .task-progress {\n        margin-left: auto;\n    }\n\n    .task-header {\n        grid-column: 1/-1;\n        display: flex;\n        align-items: center;\n        width: 100%;\n    }\n\n    .task-body {\n        display: flex;\n        flex-direction: column;\n        grid-column: 1/-1;\n        padding: 0;\n        padding-left: 1.5em;\n    }\n\n    .task-dueDate {\n        font-size: 0.9em;\n        margin-bottom: 0.5em;\n    }\n}\n\n.main-section .task-wrapper {\n    .task-title {\n        padding-left: .5em;\n    }\n\n    .task-steps {\n        border-top: 1px solid var(--accent-900);\n    }\n}\n\n.main-section .step-wrapper {\n    padding: 0 1.5em;\n}\n\n.step-wrapper {\n    display: flex;\n    flex-flow: row-reverse;\n    justify-content: space-between;\n    gap: 1em;\n\n    label:has(+ input[type=\"checkbox\"]:checked) {\n        text-decoration: line-through;\n        text-decoration-thickness: 15%;\n        opacity: 0.8;\n    }\n\n    .step-title {\n        margin-right: auto;\n    }\n\n    &>.delete-btn {\n        order: -1;\n        background: none;\n    }\n}\n\n.projects-container {\n    width: 80%;\n}\n\nul {\n    padding-left: 0;\n}\n\n.delete-btn {\n    border: none;\n}\n\n.delete-btn:before {\n    color: darkred;\n    content: \"\\00D7\";\n    font-size: 1.3em;\n}\n\n.expand-btn {\n    background: none;\n    border-radius: 50%;\n    aspect-ratio: 1/1;\n    border: none;\n    font-weight: bold;\n    font-size: 1.3em;\n\n    transition: all .5s;\n}\n\n.expand-btn:before {\n    content: \"\\27A4\";\n    color: var(--accent-700);\n}\n\n*:has(> .delete-btn:hover),\n.project-wrapper.sidebar-rendering:has(.delete-btn:hover){\n    background-color: #f6c2d9;\n}\n\n.add-btn::before {\n    position: absolute;\n    top: 0;\n    right: 0;\n    left: 0;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    overflow: hidden;\n    content: '';\n    height: 0px;\n    grid-column: 1/-1;\n    background-color: #bcdfc9;\n    transition: all .5s;\n}\n\n.new-task:hover::before {\n    content: 'Add Task';\n    height: 100%;\n    bottom: 0;\n\n}\n\n.new-step:hover::before {\n    content: 'Add Step';\n    height: 100%;\n}\n\ninput[class*='input'] {\n    background: none;\n    border: none;\n    display: inline-block;\n    width: 3ch;\n\n    &.year-input {\n        width: 5ch;\n    }\n}"],"sourceRoot":""}]);

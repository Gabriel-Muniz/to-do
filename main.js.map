___CSS_LOADER_EXPORT___.push([module.id, `.project-wrapper {
    display: grid;
    grid-template-columns: 3fr 2fr;

    padding: 1.5em 1em;

    width: 500px;
    border: 2px solid var(--accent-900);

    border-radius: .5em;
    overflow: hidden;

    background-color: var(--primary-100);

    accent-color: var(--primary-700);


    .project-title {
        grid-row: 1/3;
    }

    .project-priority {
        justify-self: end;
        grid-column: 2/3;
        grid-row: 1/2;
    }

    .project-dueDate {
        grid-column: 2;
        justify-self: end;
        grid-row: 2/3
    }

    .project-description {
        grid-column: 1/ 3;
        margin-top: .5em;
        margin-bottom: 1.5em;
    }

    .project-tasks {
        display: grid;
        grid-template-columns: subgrid;
        grid-column: 1/-1;
    }

    .delete-btn {
        grid-column: 1/3;
    }

    .new-task {
        position: relative;
        grid-column: 1/-1;
        margin: 0 -1.5em -1.5em;
        height: 2.5em;
        border: none;
        border-top: 2px solid var(--accent-900);
        background: none;
    }
}

.project-wrapper.sidebar-rendering {
    position: relative;
    display: grid;
    grid-template-columns: 2em 4fr 1fr;
    width: 100%;
    margin-bottom: 2em;

    padding: 1em;

    .project-title {
        grid-column: 2/3;
        grid-row: 2;
    }

    .project-priority {
        grid-column: 1/3;
        grid-row: 1;
        justify-self: start;
    }

    .project-dueDate {
        grid-row: 1;
        grid-column: 2/4;
        justify-self: flex-end;
    }

    .project-priority,
    .project-dueDate {
        font-size: 0.9em;
    }

    .project-tasks {
        grid-column: 1/-1;
    }

    .delete-btn {
        margin: -1em;
        margin-top: 1em;

        grid-column: 1/-1;
    }
}

.project-wrapper.sidebar-rendering:nth-child(even) {
    background-color: var(--primary-100);
    accent-color: var(--primary-700);

    .expand-btn::before {
        color: var(--primary-700);
    }
}

.project-wrapper.sidebar-rendering:nth-child(odd) {
    background-color: var(--accent-100);
    accent-color: var(--accent-700);

    .expand-btn::before {
        color: var(--accent-700);
    }
}


.project-wrapper,
.task-wrapper,
.step-wrapper {
    align-items: center;
    transition: background-color .3s ease-out;
}

.sidebar-rendering {

    .task-body,
    .project-tasks {
        transition: height 0.2s;
    }

    &:not(.expanded)>ul,
    &:not(.expanded)>.task-body {
        height: 0;
        overflow: hidden;
    }

    &.expanded>.expand-btn {
        transform: rotate(90deg);
    }

}

.task-wrapper {
    display: grid;
    grid-template-columns: 2em 3fr 2fr;
    grid-column: 1/3;

    margin: 0 -1.5em;
    padding: 0 1.5em;

    .task-dueDate {
        grid-column: 3;
        grid-row: 1;
        justify-self: end;
    }

    .task-title {
        width: 25ch;
        grid-column: 2/3;
        grid-row: 1;
    }

    .task-progress {
        grid-column: 3/4;
        grid-row: 1;

        justify-self: start;
    }

    .task-steps {
        grid-column: 1/-1;
        grid-row: 2;
    }

    &>.delete-btn {
        grid-column: 1/2;
        grid-row: 1;
        background: none;
    }

    &>.add-btn {
        grid-column: 1/-1;
    }

    .new-step {
        position: relative;
        border: 1px dashed var(--accent-900);
        background: none;
        margin-bottom: .5em;
        justify-self: center;
        width: 100%;
    }
}

.main-section .task-wrapper {
    .task-title {
        border-left: 1px solid var(--accent-900);
        border-right: 1px dotted var(--accent-900);
    }
}

.task-wrapper.sidebar-rendering {
    grid-column: 1/-1;
    grid-template-columns: 2em 3fr 1fr;
    padding: 0 0.9em;

    margin: initial;

    .expand-btn {
        grid-column: 1/2;
    }

    .task-title {
        grid-column: 2/3;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .task-progress {
        margin-left: auto;
    }

    .task-header {
        grid-column: 1/-1;
        display: flex;
        align-items: center;
        width: 100%;
    }

    .task-body {
        display: flex;
        flex-direction: column;
        grid-column: 1/-1;
        padding: 0;
        padding-left: 1.5em;
    }

    .task-dueDate {
        font-size: 0.9em;
        margin-bottom: 0.5em;
    }
}

.main-section .task-wrapper {
    .task-title {
        padding-left: .5em;
    }

    .task-steps {
        border-top: 1px solid var(--accent-900);
    }
}

.main-section .step-wrapper {
    padding: 0 1.5em;
}

.step-wrapper {
    display: flex;
    flex-flow: row-reverse;
    justify-content: space-between;
    gap: 1em;

    label:has(+ input[type="checkbox"]:checked) {
        text-decoration: line-through;
        text-decoration-thickness: 15%;
        opacity: 0.8;
    }

    .step-title {
        margin-right: auto;
    }

    &>.delete-btn {
        order: -1;
        background: none;
    }
}

.projects-container {
    width: 80%;
}

ul {
    padding-left: 0;
}

.delete-btn {
    border: none;
}

.delete-btn:before {
    color: darkred;
    content: "\\00D7";
    font-size: 1.3em;
}

.expand-btn {
    background: none;
    border-radius: 50%;
    aspect-ratio: 1/1;
    border: none;
    font-weight: bold;
    font-size: 1.3em;

    transition: all .5s;
}

.expand-btn:before {
    content: "\\27A4";
    color: var(--accent-700);
}

*:has(> .delete-btn:hover),
.project-wrapper.sidebar-rendering:has(.delete-btn:hover){
    background-color: #f6c2d9;
}

.add-btn::before {
    position: absolute;
    top: 0;
    right: 0;
    left: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    content: '';
    height: 0px;
    grid-column: 1/-1;
    background-color: #bcdfc9;
    transition: all .5s;
}

.new-task:hover::before {
    content: 'Add Task';
    height: 100%;
    bottom: 0;

}

.new-step:hover::before {
    content: 'Add Step';
    height: 100%;
}

input[class*='input'] {
    background: none;
    border: none;
    display: inline-block;
    width: 3ch;

    &.year-input {
        width: 5ch;
    }
}`, "",{"version":3,"sources":["webpack://./src/styles/projects.css"],"names":[],"mappings":"AAAA;IACI,aAAa;IACb,8BAA8B;;IAE9B,kBAAkB;;IAElB,YAAY;IACZ,mCAAmC;;IAEnC,mBAAmB;IACnB,gBAAgB;;IAEhB,oCAAoC;;IAEpC,gCAAgC;;;IAGhC;QACI,aAAa;IACjB;;IAEA;QACI,iBAAiB;QACjB,gBAAgB;QAChB,aAAa;IACjB;;IAEA;QACI,cAAc;QACd,iBAAiB;QACjB;IACJ;;IAEA;QACI,iBAAiB;QACjB,gBAAgB;QAChB,oBAAoB;IACxB;;IAEA;QACI,aAAa;QACb,8BAA8B;QAC9B,iBAAiB;IACrB;;IAEA;QACI,gBAAgB;IACpB;;IAEA;QACI,kBAAkB;QAClB,iBAAiB;QACjB,uBAAuB;QACvB,aAAa;QACb,YAAY;QACZ,uCAAuC;QACvC,gBAAgB;IACpB;AACJ;;AAEA;IACI,kBAAkB;IAClB,aAAa;IACb,kCAAkC;IAClC,WAAW;IACX,kBAAkB;;IAElB,YAAY;;IAEZ;QACI,gBAAgB;QAChB,WAAW;IACf;;IAEA;QACI,gBAAgB;QAChB,WAAW;QACX,mBAAmB;IACvB;;IAEA;QACI,WAAW;QACX,gBAAgB;QAChB,sBAAsB;IAC1B;;IAEA;;QAEI,gBAAgB;IACpB;;IAEA;QACI,iBAAiB;IACrB;;IAEA;QACI,YAAY;QACZ,eAAe;;QAEf,iBAAiB;IACrB;AACJ;;AAEA;IACI,oCAAoC;IACpC,gCAAgC;;IAEhC;QACI,yBAAyB;IAC7B;AACJ;;AAEA;IACI,mCAAmC;IACnC,+BAA+B;;IAE/B;QACI,wBAAwB;IAC5B;AACJ;;;AAGA;;;IAGI,mBAAmB;IACnB,yCAAyC;AAC7C;;AAEA;;IAEI;;QAEI,uBAAuB;IAC3B;;IAEA;;QAEI,SAAS;QACT,gBAAgB;IACpB;;IAEA;QACI,wBAAwB;IAC5B;;AAEJ;;AAEA;IACI,aAAa;IACb,kCAAkC;IAClC,gBAAgB;;IAEhB,gBAAgB;IAChB,gBAAgB;;IAEhB;QACI,cAAc;QACd,WAAW;QACX,iBAAiB;IACrB;;IAEA;QACI,WAAW;QACX,gBAAgB;QAChB,WAAW;IACf;;IAEA;QACI,gBAAgB;QAChB,WAAW;;QAEX,mBAAmB;IACvB;;IAEA;QACI,iBAAiB;QACjB,WAAW;IACf;;IAEA;QACI,gBAAgB;QAChB,WAAW;QACX,gBAAgB;IACpB;;IAEA;QACI,iBAAiB;IACrB;;IAEA;QACI,kBAAkB;QAClB,oCAAoC;QACpC,gBAAgB;QAChB,mBAAmB;QACnB,oBAAoB;QACpB,WAAW;IACf;AACJ;;AAEA;IACI;QACI,wCAAwC;QACxC,0CAA0C;IAC9C;AACJ;;AAEA;IACI,iBAAiB;IACjB,kCAAkC;IAClC,gBAAgB;;IAEhB,eAAe;;IAEf;QACI,gBAAgB;IACpB;;IAEA;QACI,gBAAgB;QAChB,mBAAmB;QACnB,gBAAgB;QAChB,uBAAuB;IAC3B;;IAEA;QACI,iBAAiB;IACrB;;IAEA;QACI,iBAAiB;QACjB,aAAa;QACb,mBAAmB;QACnB,WAAW;IACf;;IAEA;QACI,aAAa;QACb,sBAAsB;QACtB,iBAAiB;QACjB,UAAU;QACV,mBAAmB;IACvB;;IAEA;QACI,gBAAgB;QAChB,oBAAoB;IACxB;AACJ;;AAEA;IACI;QACI,kBAAkB;IACtB;;IAEA;QACI,uCAAuC;IAC3C;AACJ;;AAEA;IACI,gBAAgB;AACpB;;AAEA;IACI,aAAa;IACb,sBAAsB
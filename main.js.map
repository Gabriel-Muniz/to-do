    --text-50: #eef4f6;
    --text-100: #dde8ee;
    --text-200: #bbd2dd;
    --text-300: #99bbcc;
    --text-400: #77a4bb;
    --text-500: #558eaa;
    --text-600: #447188;
    --text-700: #335566;
    --text-800: #223944;
    --text-900: #111c22;
    --text-950: #090e11;

    --background-50: #eff2f5;
    --background-100: #dfe6ec;
    --background-200: #bfccd9;
    --background-300: #9fb2c6;
    --background-400: #8099b3;
    --background-500: #607f9f;
    --background-600: #4d6680;
    --background-700: #394c60;
    --background-800: #263340;
    --background-900: #131920;
    --background-950: #0a0d10;

    --primary-50: #eef4f6;
    --primary-100: #dde8ee;
    --primary-200: #bbd2dd;
    --primary-300: #99bbcc;
    --primary-400: #77a4bb;
    --primary-500: #558eaa;
    --primary-600: #447188;
    --primary-700: #335566;
    --primary-800: #223944;
    --primary-900: #111c22;
    --primary-950: #090e11;

    --secondary-50: #eeeef6;
    --secondary-100: #dddeee;
    --secondary-200: #bbbddd;
    --secondary-300: #999ccc;
    --secondary-400: #777bbb;
    --secondary-500: #555aaa;
    --secondary-600: #444888;
    --secondary-700: #333666;
    --secondary-800: #222444;
    --secondary-900: #111222;
    --secondary-950: #090911;

    --accent-50: #efeef6;
    --accent-100: #e0ddee;
    --accent-200: #c0bbdd;
    --accent-300: #a199cc;
    --accent-400: #8177bb;
    --accent-500: #6255aa;
    --accent-600: #4e4488;
    --accent-700: #3b3366;
    --accent-800: #272244;
    --accent-900: #141122;
    --accent-950: #0a0911;


}

body {
    min-height: 100vh;
    display: flex;
}

.sidebar {
    display: flex;
    flex-direction: column;

    align-items: center;

    padding-top: 2em;

    background-color: var(--secondary-300);
    width: 25%;
    min-width: 325px;
    height: inherit;
}

.main-section {
    padding: 5em 0;
    display: flex;
    align-items: start;
    justify-content: center;
    flex: 1;
    background-color: var(--primary-200);
}

.sidebar,
.main-section {
    overflow-y: auto;
    scrollbar-gutter: stable;
    max-height: 100vh;
}

.add-project-btn {
    position: relative;
    width: 80%;
    height: 50px;
    flex-shrink: 0;
    margin-bottom: 2em;
    transition: all .5s ease-out;
    overflow: hidden;
    font-size: 1.5em;
    border: 2px solid var(--accent-900);
    border-radius: 4px;
}

.add-project-btn::before {
    position: absolute;
    display: flex;
    justify-content: center;
    align-items: center;
    top: 0;
    left: 0;
    content: '';
    width: 100%;
    height: 0;
    transition: all .3s ease-out;
}

.add-project-btn:hover:before {
    content: 'Add Project';
    height: 100%;
    font-size: 1em;
    background-color: #bcdfc9;

}

.add-project-btn:hover {
    height: 100px;
    border: 2px solid var(--accent-900);
    border-radius: 10px;
}

button:hover {
    cursor: pointer;
}`, "",{"version":3,"sources":["webpack://./src/styles/home.css"],"names":[],"mappings":"AAAA;IACI,kBAAkB;IAClB,mBAAmB;IACnB,mBAAmB;IACnB,mBAAmB;IACnB,mBAAmB;IACnB,mBAAmB;IACnB,mBAAmB;IACnB,mBAAmB;IACnB,mBAAmB;IACnB,mBAAmB;IACnB,mBAAmB;;IAEnB,wBAAwB;IACxB,yBAAyB;IACzB,yBAAyB;IACzB,yBAAyB;IACzB,yBAAyB;IACzB,yBAAyB;IACzB,yBAAyB;IACzB,yBAAyB;IACzB,yBAAyB;IACzB,yBAAyB;IACzB,yBAAyB;;IAEzB,qBAAqB;IACrB,sBAAsB;IACtB,sBAAsB;IACtB,sBAAsB;IACtB,sBAAsB;IACtB,sBAAsB;IACtB,sBAAsB;IACtB,sBAAsB;IACtB,sBAAsB;IACtB,sBAAsB;IACtB,sBAAsB;;IAEtB,uBAAuB;IACvB,wBAAwB;IACxB,wBAAwB;IACxB,wBAAwB;IACxB,wBAAwB;IACxB,wBAAwB;IACxB,wBAAwB;IACxB,wBAAwB;IACxB,wBAAwB;IACxB,wBAAwB;IACxB,wBAAwB;;IAExB,oBAAoB;IACpB,qBAAqB;IACrB,qBAAqB;IACrB,qBAAqB;IACrB,qBAAqB;IACrB,qBAAqB;IACrB,qBAAqB;IACrB,qBAAqB;IACrB,qBAAqB;IACrB,qBAAqB;IACrB,qBAAqB;;;AAGzB;;AAEA;IACI,iBAAiB;IACjB,aAAa;AACjB;;AAEA;IACI,aAAa;IACb,sBAAsB;;IAEtB,mBAAmB;;IAEnB,gBAAgB;;IAEhB,sCAAsC;IACtC,UAAU;IACV,gBAAgB;IAChB,eAAe;AACnB;;AAEA;IACI,cAAc;IACd,aAAa;IACb,kBAAkB;IAClB,uBAAuB;IACvB,OAAO;IACP,oCAAoC;AACxC;;AAEA;;IAEI,gBAAgB;IAChB,wBAAwB;IACxB,iBAAiB;AACrB;;AAEA;IACI,kBAAkB;IAClB,UAAU;IACV,YAAY;IACZ,cAAc;IACd,kBAAkB;IAClB,4BAA4B;IAC5B,gBAAgB;IAChB,gBAAgB;IAChB,mCAAmC;IACnC,kBAAkB;AACtB;;AAEA;IACI,kBAAkB;IAClB,aAAa;IACb,uBAAuB;IACvB,mBAAmB;IACnB,MAAM;IACN,OAAO;IACP,WAAW;IACX,WAAW;IACX,SAAS;IACT,4BAA4B;AAChC;;AAEA;IACI,sBAAsB;IACtB,YAAY;IACZ,cAAc;IACd,yBAAyB;;AAE7B;;AAEA;IACI,aAAa;IACb,mCAAmC;IACnC,mBAAmB;AACvB;;AAEA;IACI,eAAe;AACnB","sourcesContent":[":root {\n    --text-50: #eef4f6;\n    --text-100: #dde8ee;\n    --text-200: #bbd2dd;\n    --text-300: #99bbcc;\n    --text-400: #77a4bb;\n    --text-500: #558eaa;\n    --text-600: #447188;\n    --text-700: #335566;\n    --text-800: #223944;\n    --text-900: #111c22;\n    --text-950: #090e11;\n\n    --background-50: #eff2f5;\n    --background-100: #dfe6ec;\n    --background-200: #bfccd9;\n    --background-300: #9fb2c6;\n    --background-400: #8099b3;\n    --background-500: #607f9f;\n    --backgroun